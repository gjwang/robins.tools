# Reown AppKit project id (create one at https://cloud.reown.com).
# Without it the app still runs; wallet connection is disabled with a hint.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional RPC override. Defaults to the public mainnet endpoint below.
# NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional public repository URL. When set, GitHub links appear in the header and footer.
NEXT_PUBLIC_GITHUB_URL=

# Published $TOOLS community token contract address. Leave empty until launch.
NEXT_PUBLIC_TOOLS_TOKEN_ADDRESS=

# Optional pre-deployed RobinsDisperse contract address for the Multisender.
# When set (and it holds code on-chain) the batch sender reuses it; otherwise the
# user deploys their own once, cached locally. Any address is user-owned and trustless.
# NEXT_PUBLIC_DISPERSE_ADDRESS=
